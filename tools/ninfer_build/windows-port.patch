+                throw std::system_error(static_cast<int>(error), std::system_category(),
+                                        "MapViewOfFile " + path.string());
+            }
+        }
+        file_handle_    = file_handle;
+        mapping_handle_ = mapping_handle;
+        data_           = static_cast<const std::byte*>(mapping);
+        size_           = size;
